# Anthropic
ANTHROPIC_API_KEY=your_key_here

# Failure injection (none | row_drop | schema_drift | null_spike | latency)
INJECT_FAILURE=none

# Tool server
TOOL_SERVER_HOST=localhost
TOOL_SERVER_PORT=8000

# Agent server
AGENT_SERVER_HOST=localhost
AGENT_SERVER_PORT=8001

# Database (mock target)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipeline_qa
POSTGRES_USER=qa_user
POSTGRES_PASSWORD=qa_pass

# Kafka (mock)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=pipeline-events

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=password
N8N_PORT=5678

# Notifications — legacy incoming webhook, superseded by the Slack bot
# below (kept only until n8n_workflows/qa_agent_workflow.json's Slack Alert
# node is migrated off it; incoming webhooks cannot thread or update).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
JENKINS_WEBHOOK_URL=http://jenkins:8080/generic-webhook-trigger/invoke
JENKINS_TOKEN=your_token_here

# Slack app (bot token) — incident channel. See expansion-plan.md section
# 4.A6 and IMPLEMENTATION.md's Phase 1 human-prerequisites checklist for
# how to obtain these. SLACK_MODE=stub (the default when unset) writes
# every payload Slack would have received to reports/slack/ instead of
# calling the network — the repo is fully runnable and testable with no
# Slack workspace at all. Set SLACK_MODE=live once the app is installed.
SLACK_MODE=stub
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_CHANNEL_ALERTS=C0000000ALERTS
SLACK_CHANNEL_P1=C0000000P1
SLACK_CHANNEL_CHANGES=C0000000CHANGES
SLACK_CHANNEL_DAILY=C0000000DAILY
SLACK_APPROVERS=U0000000AAA,U0000000BBB
APPROVAL_MODE=interactive
PUBLIC_WEBHOOK_BASE=https://your-tunnel-hostname

# Thresholds (optional overrides)
ROW_DROP_THRESHOLD=5.0
NULL_RATE_THRESHOLD=0.05
KAFKA_LAG_THRESHOLD=10000
