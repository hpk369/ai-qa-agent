# Copy this file to .env and fill in what you use — .env is gitignored and is
# loaded by the CLIs (agent/env.py). Anything already exported in your shell
# wins over this file. Never commit a filled-in copy.

# The model that writes the human-facing part of each alert and decides
# whether a Slack reply actually confirms an incident is resolved
# (agent/llm.py, agent/providers.py). Any of these work; leave them all
# unset and everything still runs on deterministic fallbacks.
#
# auto (first one configured) | anthropic | openai | ollama | off
LLM_PROVIDER=auto

# --- Option 1: a local model. Free, no account, auto-detected.
#     ollama serve && ollama pull llama3.2
# Nothing to set. Override the host or model if yours differ:
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=qwen2.5:7b

# --- Option 2: any hosted OpenAI-compatible endpoint (Groq, OpenRouter,
#     Together, Fireworks, DeepSeek, Gemini's compat endpoint, a vLLM you run).
#     Several have free tiers.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Option 3: the Claude API (paid — no free model). Defaults to Haiku 4.5,
#     the cheapest current model, at about $0.004 per incident. Opus 5 is ~14x
#     that because its thinking tokens bill as output — see the README's cost
#     table before changing this.
AGENT_MODEL=claude-haiku-4-5
#
#     Pick ONE credential. Leave the others commented out — a variable set to
#     an empty string still wins its slot in the SDK's precedence chain, so a
#     blank ANTHROPIC_API_KEY= would shadow federation and authenticate with an
#     empty key. (This loader skips blank values for exactly that reason, but
#     an exported blank in your shell would still do it.)
#
#     a) Workload identity federation — no static secret, tokens expire in
#        minutes. For CI and cloud workloads; set up in the Console under
#        Settings > Workload identity.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_IDENTITY_TOKEN_FILE=/var/run/secrets/anthropic.com/token
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   # only if the rule covers several workspaces
#
#     b) An `ant auth login` profile — keyless on a developer machine.
#        Nothing to set here; the SDK finds it under ~/.config/anthropic.
#
#     c) A long-lived API key.
# ANTHROPIC_API_KEY=sk-ant-...

# Seconds to wait for an inference call before falling back.
LLM_TIMEOUT=60

# Agent server
AGENT_SERVER_HOST=localhost
AGENT_SERVER_PORT=8001

# Public base URL of the agent server, if it has one. When set, a log-set
# Slack alert renders a "Download log set" button pointing at
# AGENT_PUBLIC_URL/logset/<session_id>/download instead of printing a local
# path. Leave unset for local runs — the alert then carries the zip's path.
AGENT_PUBLIC_URL=

# Slack app (bot token) — the incident channel. See docs/SLACK_SETUP.md for
# exactly how to obtain every value below. SLACK_MODE=stub (the default
# when unset) writes every payload Slack would have received to
# reports/slack/ instead of calling the network — the repo is fully
# runnable and testable with no Slack workspace at all. Set SLACK_MODE=live
# once the app is installed and every value below is real.
SLACK_MODE=stub
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_CHANNEL_ALERTS=C0000000ALERTS
SLACK_CHANNEL_P1=C0000000P1
SLACK_CHANNEL_CHANGES=C0000000CHANGES
SLACK_CHANNEL_DAILY=C0000000DAILY

# Thresholds (optional override)
KAFKA_LAG_THRESHOLD=10000
