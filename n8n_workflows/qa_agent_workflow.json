{
  "name": "ETL Production Support Triage Agent Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pipeline-trigger",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-trigger",
      "name": "Pipeline Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent_server:8001/agent/run",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "run_id",
              "value": "={{ $json.run_id }}"
            },
            {
              "name": "pipeline",
              "value": "={{ $json.pipeline }}"
            },
            {
              "name": "timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "source_table",
              "value": "={{ $json.source_table }}"
            },
            {
              "name": "target_table",
              "value": "={{ $json.target_table }}"
            },
            {
              "name": "log_path",
              "value": "={{ $json.log_path }}"
            },
            {
              "name": "failure_mode",
              "value": "={{ $json.failure_mode }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "node-call-agent",
      "name": "Call Triage Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "condition-clean",
              "leftValue": "={{ $json.clean }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-check-incident-status",
      "name": "Check Incident Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "command": "cd /qa && robot --outputdir reports/robot tests/robot/acceptance.robot 2>&1; echo \"EXIT_CODE:$?\""
      },
      "id": "node-run-robot",
      "name": "Run Robot Framework",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        180
      ]
    },
    {
      "parameters": {
        "command": "cd /qa && pytest tests/pytest/ --junitxml=reports/pytest/results.xml -v 2>&1; echo \"EXIT_CODE:$?\""
      },
      "id": "node-run-pytest",
      "name": "Run pytest",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        420
      ]
    },
    {
      "parameters": {
        "filePath": "/qa/reports/robot/output.xml"
      },
      "id": "node-read-robot-report",
      "name": "Read RF Report",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        1120,
        180
      ]
    },
    {
      "parameters": {
        "filePath": "/qa/reports/pytest/results.xml"
      },
      "id": "node-read-pytest-report",
      "name": "Read pytest Report",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        1120,
        420
      ]
    },
    {
      "parameters": {
        "mode": "mergeByPosition",
        "options": {}
      },
      "id": "node-merge",
      "name": "Merge Reports",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const agentResult = $('Call Triage Agent').first().json;\n\nconst incident = agentResult.incident;\nconst clean = agentResult.clean === true;\n\nconst severityEmoji = { P1: '🔴', P2: '🟠', P3: '🟡', P4: '⚪' };\nconst emoji = clean ? '✅' : (severityEmoji[incident && incident.severity] || '❗');\n\nconst summary = {\n  run_id: $('Pipeline Trigger').first().json.run_id,\n  clean,\n  incident_id: incident ? incident.incident_id : null,\n  severity: incident ? incident.severity : null,\n  impact_summary: incident ? incident.impact_summary : 'No issues detected.',\n  root_cause: incident ? incident.root_cause : null,\n  recommended_action: incident ? incident.recommended_action : null,\n  confidence: incident ? incident.confidence : null,\n  checks_performed: agentResult.checks_performed || [],\n  requires_approval: incident ? incident.requires_approval : false,\n  runbook: incident ? incident.runbook : null,\n  validation_framework: clean ? 'Robot Framework' : 'pytest',\n  timestamp: new Date().toISOString(),\n};\n\nconst slack_message = [\n  `${emoji} *ETL Production Support* — ${clean ? 'No Incident' : `Incident ${summary.incident_id} (${summary.severity})`}`,\n  `*Run ID:* ${summary.run_id}`,\n  `*Impact:* ${summary.impact_summary}`,\n  summary.root_cause ? `*Root Cause:* ${summary.root_cause}` : '',\n  summary.recommended_action ? `*Recommended Action:* ${summary.recommended_action}` : '',\n  summary.runbook ? `*Runbook:* ${summary.runbook}` : '',\n  `*Confidence:* ${summary.confidence != null ? (summary.confidence * 100).toFixed(0) + '%' : 'n/a'}`,\n  `*Validation via:* ${summary.validation_framework}`,\n].filter(Boolean).join('\\n');\n\nreturn [{ json: { summary, slack_message, clean } }];"
      },
      "id": "node-build-incident-record",
      "name": "Build Incident Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "webhookUri": "={{ $env.SLACK_WEBHOOK_URL }}",
        "text": "={{ $json.slack_message }}",
        "otherOptions": {
          "username": "Triage Agent",
          "icon_emoji": ":robot_face:"
        }
      },
      "id": "node-slack",
      "name": "Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        1780,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JENKINS_WEBHOOK_URL }}",
        "authentication": "genericCredentialType",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $env.JENKINS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($json.summary) }}",
        "options": {}
      },
      "id": "node-jenkins",
      "name": "Jenkins Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1780,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Build Incident Record').first().json.summary) }}"
      },
      "id": "node-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2000,
        300
      ]
    }
  ],
  "connections": {
    "Pipeline Trigger": {
      "main": [
        [
          {
            "node": "Call Triage Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Triage Agent": {
      "main": [
        [
          {
            "node": "Check Incident Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Incident Status": {
      "main": [
        [
          {
            "node": "Run Robot Framework",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Run pytest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Robot Framework": {
      "main": [
        [
          {
            "node": "Read RF Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run pytest": {
      "main": [
        [
          {
            "node": "Read pytest Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read RF Report": {
      "main": [
        [
          {
            "node": "Merge Reports",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read pytest Report": {
      "main": [
        [
          {
            "node": "Merge Reports",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Reports": {
      "main": [
        [
          {
            "node": "Build Incident Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Incident Record": {
      "main": [
        [
          {
            "node": "Slack Alert",
            "type": "main",
            "index": 0
          },
          {
            "node": "Jenkins Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack Alert": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Jenkins Webhook": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 1
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "pinData": {}
}
